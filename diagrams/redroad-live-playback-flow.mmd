%%{init: {"theme": "base", "themeVariables": {"fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif", "primaryColor": "#f5f5f7", "primaryTextColor": "#1d1d1f", "primaryBorderColor": "#d2d2d7", "lineColor": "#86868b", "secondaryColor": "#e8f3ff", "tertiaryColor": "#fff2f2"}}}%%
graph TD
  A["选择频道或节目"] --> B{"节目状态"}
  B -->|正在直播| C["打开节目详情"]
  B -->|即将播放| C
  B -->|节目单选择| C
  C --> D{"已登录且已选 Profile?"}
  D -->|否| E["登录 / 选择 Profile / PIN"]
  E --> F["服务端播放授权"]
  D -->|是| F
  F -->|通过| G["建立播放会话"]
  F -->|拒绝| H["说明原因\n给出下一步"]
  G --> I["全屏播放器"]
  I --> J["切换频道 / 刷新直播状态"]
  I --> K["退出播放"]
  K --> L["恢复原节目单、焦点与滚动位置"]
  C --> M["收藏 / 查看节目单"]

  classDef decision fill:#fff8e7,color:#1d1d1f,stroke:#ff9f0a,stroke-width:2px;
  classDef action fill:#e8f3ff,color:#1d1d1f,stroke:#007aff,stroke-width:2px;
  classDef playback fill:#fff2f2,color:#1d1d1f,stroke:#ff3b30,stroke-width:2px;
  classDef terminal fill:#111111,color:#ffffff,stroke:#111111,stroke-width:2px;
  class B,D decision;
  class C,E,F,H,J,K,M action;
  class G,I playback;
  class A,L terminal;
