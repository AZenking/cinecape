# Home Media Platform — 服务端配置示例
# 复制为 .env 并按需修改;所有配置仅经环境注入(FR-004),.env 不入库

NODE_ENV=development
PORT=3000

# SQLite 数据目录(容器内为 /data 卷)
DATA_DIR=./data
DB_FILENAME=hmp.db

# 会话:滑动 30 天,绝对上限 90 天(research D5)
SESSION_TTL_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# PIN 锁定:连续 5 次失败锁 5 分钟
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=5

# 局域网 HTTP 部署保持 false;HTTPS/公网必须 true
COOKIE_SECURE=false

LOG_LEVEL=info

# NAS 只读根映射(T010):rootKey=/绝对/路径,逗号分隔。
# rootKey 为 1~64 字符的 [A-Za-z0-9_-];路径必须绝对且不含「..」段;缺省为空 = 未授权任何 NAS 根。
# MEDIA_ROOTS=videos=/volume1/videos,music=/volume1/music

# 远程导入/拉流目标部署级精确许可(T010):host、host:port 或 CIDR(IPv4/IPv6),逗号分隔。
# 拒绝通配符与「/0」允许全部(0.0.0.0/0、::/0 非法);缺省为空 = 所有远程目标拒绝。
# 受控例外:条目 `public` 放行全部公网单播目标;私网(RFC1918/ULA)/环回/元数据仍须精确条目。
# LAN_ALLOWED_TARGETS=nas.local:5000,192.168.1.0/24,fd00::/16
# LAN_ALLOWED_TARGETS=public

# 播放转码/票据可调预算(004 T010):非法值启动拒绝。
# 转换并发 1~8(默认 1,所有 remux/transcode 共用额度);软件转码每任务线程 1~8(默认 2);
# 播放票据 TTL 60~900 秒(默认 300 = 5 分钟,续期固定提前 60 秒)。
# PLAYBACK_CONVERSION_CONCURRENCY=1
# PLAYBACK_SOFTWARE_THREADS=2
# PLAYBACK_TICKET_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# TMDB 节目海报(020,可选)
# 留空 TMDB_API_KEY 与 TMDB_READ_ACCESS_TOKEN = 完全关闭网络查询;节目单仍可浏览。
# 启用后,节目标题会发送给 TMDB(不含账号/Profile/设备/播放地址);默认非商业用途。
# 缓存期限硬上限 180 天(TMDB API Terms 要求 ≤6 个月);公共页面展示 TMDB 署名。
# ---------------------------------------------------------------------------
# v3 API Key 或 v4 Read Access Token(二选一;v4 优先)
# TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=
# 检索语言/地区:中文简体 zh-CN + CN;繁中可改 zh-TW + TW
# TMDB_LANGUAGE=zh-CN
# TMDB_REGION=CN
# 可选自建代理基址(生产建议 https;不得含 userinfo/query/fragment)
# TMDB_API_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w342
# 节流:单进程串行 1 条;最小间隔 150ms(约 6.7 次/秒);单次最多 300 次;总预算 90s
# TMDB_MAX_LOOKUPS_PER_RUN=300
# TMDB_LOOKUP_INTERVAL_MS=150
# TMDB_RUN_BUDGET_MS=90000
# 缓存:已匹配 180 天(硬上限 180)/ 未匹配 30 天 / 失败 60 分钟
# TMDB_MATCHED_TTL_DAYS=180
# TMDB_NEGATIVE_TTL_DAYS=30
# TMDB_FAILURE_TTL_MINUTES=60
