{
  "name": "@hmp/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -R src/platform/database/migrations dist/platform/database/",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-runner.mjs",
    "test:unit": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "migration:up": "tsx src/platform/database/migrate.ts up",
    "migration:down": "tsx src/platform/database/migrate.ts down",
    "migration:drill": "tsx src/platform/database/migrate.ts drill",
    "audit:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "audit:orphans": "knip",
    "audit:purity": "node scripts/audit-purity.mjs",
    "tmdb:backfill": "tsx scripts/tmdb-backfill.ts"
  },
  "dependencies": {
    "@hmp/shared": "workspace:*",
    "@internationalized/date": "3.12.4",
    "@nestjs/common": "^12",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "argon2": "^0.44",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.44",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "sax": "1.4.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/testing": "^12",
    "@types/better-sqlite3": "^7",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/supertest": "^6",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.43.0",
    "supertest": "^7",
    "tsc-alias": "^1.9.9",
    "tsx": "^4",
    "typescript": "^5.8",
    "vitest": "^3"
  }
}
