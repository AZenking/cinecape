{
  "name": "@hmp/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "gen:types": "openapi-typescript ../../docs/specs/001-scaffold-identity-foundation/contracts/openapi.yaml -o src/schema.d.ts",
    "build": "tsc -p tsconfig.build.json && cp src/schema.d.ts dist/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "openapi-typescript": "^7",
    "typescript": "^5.8"
  }
}
